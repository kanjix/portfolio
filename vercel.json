{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/portfolio",
  "devCommand": "ng serve",
  "env": {
    "SKIP_ENV_VALIDATION": "true"
  },
  "routes": [
    {
      "src": "^/(?!.*\\.).*$",
      "dest": "/index.html"
    },
    {
      "src": "/.*",
      "dest": "$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*).(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|gif|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    }
  ]
}
